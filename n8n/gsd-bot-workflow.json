        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"task_id\": {{$json.task_id}},\n  \"status\": \"{{$json.status}}\",\n  \"result\": {{JSON.stringify($json.result)}},\n  \"error\": {{JSON.stringify($json.error || null)}}\n}"
      },
      "name": "Callback to bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        300
      ],
      "id": "cb-bot"
    },
