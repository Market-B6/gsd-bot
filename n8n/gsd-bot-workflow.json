          "rules": [
            {
              "value2": "photo_meal",
              "output": 0,
              "operation": "equal"
            },
            {
              "value2": "weekly_analysis",
              "output": 1,
              "operation": "equal"
            },
            {
              "value2": "chat",
              "output": 2,
              "operation": "equal"
            },
            {
              "value2": "portion_advice",
              "output": 3,
              "operation": "equal"
            }
          ]
        }
      },
      "name": "Route by task_type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        460,
        300
      ],
      "id": "sw-route"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIBECODE_BASE_URL}}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.VIBECODE_API_KEY}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"model\": \"{{$env.AI_MODEL}}\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты нутрициолог, специализирующийся на гестационном сахарном диабете (ГСД). По фото блюда оцени состав, БЖУ (граммы), ХЕ (хлебные единицы), гликемический индекс и риск скачка сахара для беременной с ГСД (low/medium/high). Верни ТОЛЬКО валидный JSON без комментариев, в формате: {\\\"dish\\\": string, \\\"protein_g\\\": number, \\\"fat_g\\\": number, \\\"carb_g\\\": number, \\\"xe\\\": number, \\\"gi\\\": number, \\\"risk_level\\\": \\\"low\\\"|\\\"medium\\\"|\\\"high\\\", \\\"advice\\\": string}. Совет пиши коротко, по-русски.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": [\n        { \"type\": \"text\", \"text\": \"Проанализируй блюдо на фото.\" },\n        {\n          \"type\": \"image_url\",\n          \"image_url\": { \"url\": \"data:{{$json.data.mime || 'image/jpeg'}};base64,{{$json.data.image_b64}}\" }\n        }\n      ]\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Claude: photo → BJU",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        100
      ],
      "id": "cl-photo",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIBECODE_BASE_URL}}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.VIBECODE_API_KEY}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"model\": \"{{$env.AI_MODEL}}\",\n  \"max_tokens\": 1500,\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Ты эндокринолог-нутрициолог, специализирующийся на ГСД. На основе дневника пациентки за неделю выдай короткий структурированный анализ по-русски (маркдаун): 1) Ключевые паттерны 2) Что провоцирует скачки сахара 3) Персональные рекомендации по питанию и режиму. Без общих фраз, только конкретика по её данным.\" },\n    { \"role\": \"user\", \"content\": \"Дневник (JSON):\\n{{JSON.stringify($json.data.diary)}}\" }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Claude: weekly analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        260
      ],
      "id": "cl-week",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIBECODE_BASE_URL}}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.VIBECODE_API_KEY}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"model\": \"{{$env.AI_MODEL}}\",\n  \"max_tokens\": 800,\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Ты AI-нутрициолог для беременных с ГСД. Отвечай кратко, дружелюбно, по-русски. Не ставь диагнозов, при тревожных симптомах советуй обратиться к врачу.\" },\n    { \"role\": \"user\", \"content\": \"Контекст пациентки: {{JSON.stringify($json.data.context)}}\\n\\nВопрос: {{$json.data.question}}\" }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Claude: chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        420
      ],
      "id": "cl-chat",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIBECODE_BASE_URL}}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.VIBECODE_API_KEY}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"model\": \"{{$env.AI_MODEL}}\",\n  \"max_tokens\": 500,\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Пациентка с ГСД хочет съесть определённый продукт. На основе её последних замеров и срока подбери БЕЗОПАСНУЮ порцию в граммах и объясни как её сочетать с белком/жиром для стабильного сахара. JSON: {\\\"recommendation\\\": string, \\\"max_grams\\\": number}\" },\n    { \"role\": \"user\", \"content\": \"Продукт: {{$json.data.food}}\\nКонтекст: {{JSON.stringify($json.data.context)}}\" }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Claude: portion advice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        580
      ],
      "id": "cl-portion",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "functionCode": "// Parse vibecode (OpenAI-compatible) response -> JSON result\nconst raw = $input.first().json;\nconst webhook = $('Webhook: AI request').first().json;\n\n// Upstream error (e.g. 429 saturated group) -> report failure, do not fake a result\nif (raw && raw.error) {\n  return [{ json: { task_id: webhook.task_id, status: 'failed', error: String(raw.error.message || raw.error), result: null, callback_url: webhook.callback_url, callback_token: webhook.callback_token } }];\n}\n\nlet text = raw?.choices?.[0]?.message?.content;\nif (Array.isArray(text)) { text = text.map(p => p?.text || '').join(''); }\nif (text === undefined || text === null) { text = raw?.content?.[0]?.text ?? raw; }\n\nlet result;\nif (typeof text === 'string') {\n  const m = text.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { result = JSON.parse(m[0]); } catch (e) { result = { answer: text }; } }\n  else { result = { answer: text }; }\n} else {\n  result = text;\n}\nreturn [{ json: { task_id: webhook.task_id, status: 'done', result, callback_url: webhook.callback_url, callback_token: webhook.callback_token } }];"
      },
      "name": "Format result",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ],
      "id": "fn-fmt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.callback_url}}",
