{
  "name": "GSD Bot — Full Orchestration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gsd-ai",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook: AI request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "id": "webhook-ai",
      "webhookId": "gsd-ai"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.task_type}}",
        "rules": {
          "rules": [
            {"value2": "photo_meal", "output": 0},
            {"value2": "weekly_analysis", "output": 1},
            {"value2": "chat", "output": 2},
            {"value2": "portion_advice", "output": 3}
          ]
        }
      },
      "name": "Route by task_type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "switch-router"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIBECODE_BASE_URL}}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{$env.VIBECODE_API_KEY}}"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParametersUi": "json",
        "jsonBody": "={\n  \"model\": \"{{$env.AI_MODEL}}\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты нутрициолог, специализирующийся на гестационном сахарном диабете (ГСД). По фото блюда оцени состав, БЖУ (граммы), ХЕ (хлебные единицы), гликемический индекс и риск скачка сахара для беременной с ГСД (low/medium/high). Верни ТОЛЬКО валидный JSON без комментариев, в формате: {\\\"dish\\\": string, \\\"protein_g\\\": number, \\\"fat_g\\\": number, \\\"carb_g\\\": number, \\\"xe\\\": number, \\\"gi\\\": number, \\\"risk_level\\\": \\\"low\\\"|\\\"medium\\\"|\\\"high\\\", \\\"advice\\\": string}. Совет пиши коротко, по-русски.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\"type\": \"text\", \"text\": \"Проанализируй блюдо на фото.\"},\n        {\"type\": \"image_url\", \"image_url\": {\"url\": \"data:{{$json.data.mime || 'image/jpeg'}};base64,{{$json.data.image_b64}}\"}}\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Claude: photo → BJU",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 180],
      "id": "claude-photo"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIBECODE_BASE_URL}}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{$env.VIBECODE_API_KEY}}"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParametersUi": "json",
        "jsonBody": "={\n  \"model\": \"{{$env.AI_MODEL}}\",\n  \"max_tokens\": 1500,\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"Ты эндокринолог-нутрициолог, специализирующийся на ГСД. На основе дневника пациентки за неделю выдай короткий структурированный анализ по-русски (маркдаун): 1) Ключевые паттерны 2) Что провоцирует скачки сахара 3) Персональные рекомендации по питанию и режиму. Без общих фраз, только конкретика по её данным.\"},\n    {\"role\": \"user\", \"content\": \"Дневник (JSON):\\n{{JSON.stringify($json.data.weekly_summary)}}\"}\n  ]\n}",
        "options": {}
      },
      "name": "Claude: weekly analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 300],
      "id": "claude-weekly"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIBECODE_BASE_URL}}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{$env.VIBECODE_API_KEY}}"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParametersUi": "json",
        "jsonBody": "={\n  \"model\": \"{{$env.AI_MODEL}}\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"Ты нутрициолог-ассистент для беременных с ГСД. Отвечай на вопросы кратко, по-русски, с учётом гестационного сахарного диабета.\"},\n    {\"role\": \"user\", \"content\": \"{{$json.data.user_question}}\"}\n  ]\n}",
        "options": {}
      },
      "name": "Claude: chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 420],
      "id": "claude-chat"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VIBECODE_BASE_URL}}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{$env.VIBECODE_API_KEY}}"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParametersUi": "json",
        "jsonBody": "={\n  \"model\": \"{{$env.AI_MODEL}}\",\n  \"max_tokens\": 512,\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"Ты нутрициолог. Дай короткий совет (до 200 слов) по размеру порций для беременной с ГСД, исходя из её данных.\"},\n    {\"role\": \"user\", \"content\": \"Мои данные: вес {{$json.data.weight_kg}} кг, срок {{$json.data.weeks}} недель, средний сахар {{$json.data.avg_glucose}}. Как мне порционировать?\"}\n  ]\n}",
        "options": {}
      },
      "name": "Claude: portion advice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 540],
      "id": "claude-portion"
    },
    {
      "parameters": {
        "functionCode": "const raw = $input.first().json;\nconst webhook = $('Webhook: AI request').first().json;\n\nif (raw && raw.error) {\n  return [{ json: { task_id: webhook.task_id, status: 'failed', error: String(raw.error.message || raw.error), result: null, callback_url: webhook.callback_url, callback_token: webhook.callback_token } }];\n}\n\nlet text = raw?.choices?.[0]?.message?.content;\nif (Array.isArray(text)) { text = text.map(p => p?.text || '').join(''); }\nif (text === undefined || text === null) { text = raw?.content?.[0]?.text ?? raw; }\n\nlet result;\nif (typeof text === 'string') {\n  const m = text.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { result = JSON.parse(m[0]); } catch (e) { result = { answer: text }; } }\n  else { result = { answer: text }; }\n} else {\n  result = text;\n}\nreturn [{ json: { task_id: webhook.task_id, status: 'done', result, callback_url: webhook.callback_url, callback_token: webhook.callback_token } }];"
      },
      "name": "Format result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "id": "format-result"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.callback_url}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{$json.callback_token}}"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParametersUi": "json",
        "jsonBody": "={\n  \"task_id\": \"{{$json.task_id}}\",\n  \"status\": \"{{$json.status}}\",\n  \"result\": {{JSON.stringify($json.result)}}\n}",
        "options": {}
      },
      "name": "Callback to bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1120, 300],
      "id": "callback-bot"
    },
    {
      "parameters": {
        "interval": ["1h"]
      },
      "name": "Cron: hourly (reminders)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 700],
      "id": "cron-hourly"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.PUBLIC_BASE_URL}}/api/v1/internal/users/reminders?kind=fasting",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{$env.N8N_CALLBACK_TOKEN}}"}
          ]
        },
        "options": {}
      },
      "name": "GET users to remind",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [460, 700],
      "id": "get-reminders"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "bodyParametersUi": "json",
        "jsonBody": "={\n  \"chat_id\": {{$json.tg_id}},\n  \"text\": \"{{$json.reminder_text}}\"\n}",
        "options": {}
      },
      "name": "TG: send reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 700],
      "id": "tg-send-reminders"
    },
    {
      "parameters": {
        "interval": ["9:00"]
      },
      "name": "Cron: daily 09:00 (admin digest)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 900],
      "id": "cron-daily"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.PUBLIC_BASE_URL}}/api/v1/internal/admin/digest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{$env.N8N_CALLBACK_TOKEN}}"}
          ]
        },
        "options": {}
      },
      "name": "GET admin digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [460, 900],
      "id": "get-digest"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "bodyParametersUi": "json",
        "jsonBody": "={\n  \"chat_id\": {{$env.ADMIN_TG_ID}},\n  \"text\": \"{{$json.digest_text}}\",\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {}
      },
      "name": "TG: send digest to admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 900],
      "id": "tg-digest"
    },
    {
      "parameters": {
        "interval": ["0 20 * * 0"]
      },
      "name": "Cron: weekly AI analysis (Sun 20:00)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 1100],
      "id": "cron-weekly"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.PUBLIC_BASE_URL}}/api/v1/internal/users/pro",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{$env.N8N_CALLBACK_TOKEN}}"}
          ]
        },
        "options": {}
      },
      "name": "GET all PRO users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [460, 1100],
      "id": "get-pro-users"
    }
  ],
  "connections": {
