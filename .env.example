# Database
DATABASE_URL=postgresql://gsd_user:gsd_pass@localhost:5432/gsd_db

# Telegram Bot
BOT_TOKEN=your_bot_token_here
WEBHOOK_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-secret-key-change-in-production

# Admin
ADMIN_TG_ID=6935167265
ADMIN_USERNAME=av69ru

# Public URL — n8n должен по нему достучаться до /api/v1/ai/callback
PUBLIC_BASE_URL=

# n8n Integration
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/gsd-ai
N8N_CALLBACK_TOKEN=

# AI — только через vibecode (OpenAI-совместимый шлюз). Прямые ключи Anthropic НЕ используем.
VIBECODE_API_KEY=
VIBECODE_BASE_URL=https://vibecode-api.online/v1
AI_MODEL=claude-sonnet-5
AI_MODEL_FALLBACK=claude-haiku-4-5-20251001

# Timezone
DEFAULT_TIMEZONE=Europe/Moscow

# Payments — Telegram Stars
STARS_ENABLED=true
